classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +update_profile(name: str, species: str) None
    }

    class Task {
        +str description
        +int duration_minutes
        +str frequency
        +bool completed
        +str priority
        +str pet_name
        +mark_complete() None
        +is_valid() bool
        +format_for_schedule() str
    }

    class Scheduler {
        +Owner owner
        +get_all_tasks() list~Task~
        +get_pending_tasks() list~Task~
        +build_schedule(available_minutes: int) list~Task~
        +format_schedule(available_minutes: int) str
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : needs care
    Scheduler "1" --> "1" Owner : reads tasks from
    Scheduler "1" o-- "0..*" Task : organizes
