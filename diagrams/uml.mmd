classDiagram
    class Owner {
        +str name
        +str preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +update_preferences(preferences: str) None
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +update_profile(name: str, species: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str notes
        +validate() bool
        +describe() str
    }

    class Schedule {
        +str date
        +int available_minutes
        +list~Task~ selected_tasks
        +str explanation
        +build(tasks: list~Task~) None
        +display() str
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : needs care
    Schedule "1" o-- "0..*" Task : includes
